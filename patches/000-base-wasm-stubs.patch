From: Johnny D <goforjohnny@icloud.com>
Date: Sun, 31 May 2026 16:49:45 -0400
Subject: [PATCH 1/3] patch: add base wasm/unix stubs

---
 core/base_unix.go | 23 +++++++++++++++++++++++
 core/base_wasm.go | 10 ++++++++++
 2 files changed, 33 insertions(+)
 create mode 100644 core/base_unix.go
 create mode 100644 core/base_wasm.go

diff --git a/core/base_unix.go b/core/base_unix.go
new file mode 100644
index 0000000..8004e84
--- /dev/null
+++ b/core/base_unix.go
@@ -0,0 +1,23 @@
+//go:build !js
+
+package core
+
+import (
+	"os"
+	"path/filepath"
+)
+
+func (app *BaseApp) prepareDataDir() error {
+	dataDir := app.DataDir()
+	if err := os.MkdirAll(dataDir, os.ModePerm); err != nil {
+		return err
+	}
+	// try to cleanup the pb_data temp directory (if any)
+	_ = os.RemoveAll(filepath.Join(dataDir, LocalTempDirName))
+
+	return nil
+}
+
+func (app *BaseApp) registerNotifyWatcherHooks() {
+	// no fsnotify hooks to register in this version
+}
diff --git a/core/base_wasm.go b/core/base_wasm.go
new file mode 100644
index 0000000..62b378e
--- /dev/null
+++ b/core/base_wasm.go
@@ -0,0 +1,10 @@
+//go:build js && wasm
+
+package core
+
+func (app *BaseApp) prepareDataDir() error {
+	return nil
+}
+
+func (app *BaseApp) registerNotifyWatcherHooks() {
+}
