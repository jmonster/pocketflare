 // Restart restarts (aka. replaces) the current running application process.
 //
 // NB! It relies on execve which is supported only on UNIX based systems.
diff --git a/core/base_unix.go b/core/base_unix.go
new file mode 100644
index 0000000..8004e84
--- /dev/null
+++ b/core/base_unix.go
@@ -0,0 +1,23 @@
+//go:build !js
+
+package core
+
+import (
+	"os"
+	"path/filepath"
+)
+
+func (app *BaseApp) prepareDataDir() error {
+	dataDir := app.DataDir()
+	if err := os.MkdirAll(dataDir, os.ModePerm); err != nil {
+		return err
+	}
+	// try to cleanup the pb_data temp directory (if any)
+	_ = os.RemoveAll(filepath.Join(dataDir, LocalTempDirName))
+
+	return nil
+}
+
+func (app *BaseApp) registerNotifyWatcherHooks() {
+	// no fsnotify hooks to register in this version
+}
