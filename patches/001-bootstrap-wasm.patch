 	"github.com/pocketbase/pocketbase/tools/mailer"
@@ -398,7 +397,7 @@ func (app *BaseApp) Bootstrap() error {
 		}
 
 		// ensure that data dir exist
-		if err := os.MkdirAll(app.DataDir(), os.ModePerm); err != nil {
