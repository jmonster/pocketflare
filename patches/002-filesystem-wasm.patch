From 06f2715370be23e7e74e8d7f58d0b7bb066b6b55 Mon Sep 17 00:00:00 2001
From: Johnny D <goforjohnny@icloud.com>
Date: Sat, 30 May 2026 02:51:42 -0400
Subject: [PATCH 3/5] wasm: add build-tagged filesystem constructors

Non-WASM: local/S3 filesystem (unchanged).
WASM: injected NewWasmFilesystem/NewWasmBackupsFilesystem funcs,
set by the adapter layer to provide R2-backed blob.Driver instances.
---
 core/base_filesystem.go      | 41 ++++++++++++++++++++++++++++++++++++
 core/base_filesystem_wasm.go | 30 ++++++++++++++++++++++++++
 2 files changed, 71 insertions(+)
 create mode 100644 core/base_filesystem.go
 create mode 100644 core/base_filesystem_wasm.go

diff --git a/core/base_filesystem.go b/core/base_filesystem.go
new file mode 100644
index 0000000..5a24d2c
--- /dev/null
+++ b/core/base_filesystem.go
@@ -0,0 +1,41 @@
+//go:build !js
+
+package core
+
+import (
+	"path/filepath"
+
+	"github.com/pocketbase/pocketbase/tools/filesystem"
+)
+
+func (app *BaseApp) NewFilesystem() (*filesystem.System, error) {
+	if app.settings != nil && app.settings.S3.Enabled {
+		return filesystem.NewS3(
+			app.settings.S3.Bucket,
+			app.settings.S3.Region,
+			app.settings.S3.Endpoint,
+			app.settings.S3.AccessKey,
+			app.settings.S3.Secret,
+			app.settings.S3.ForcePathStyle,
+		)
+	}
+
+	// fallback to local filesystem
+	return filesystem.NewLocal(filepath.Join(app.DataDir(), LocalStorageDirName))
+}
+
+func (app *BaseApp) NewBackupsFilesystem() (*filesystem.System, error) {
+	if app.settings != nil && app.settings.Backups.S3.Enabled {
+		return filesystem.NewS3(
+			app.settings.Backups.S3.Bucket,
+			app.settings.Backups.S3.Region,
+			app.settings.Backups.S3.Endpoint,
+			app.settings.Backups.S3.AccessKey,
+			app.settings.Backups.S3.Secret,
+			app.settings.Backups.S3.ForcePathStyle,
+		)
+	}
+
+	// fallback to local filesystem
+	return filesystem.NewLocal(filepath.Join(app.DataDir(), LocalBackupsDirName))
+}
diff --git a/core/base_filesystem_wasm.go b/core/base_filesystem_wasm.go
new file mode 100644
index 0000000..d2a2e3f
--- /dev/null
+++ b/core/base_filesystem_wasm.go
@@ -0,0 +1,30 @@
+//go:build js && wasm
+
+package core
+
+import (
+	"fmt"
+
+	"github.com/pocketbase/pocketbase/tools/filesystem"
+)
+
+// NewWasmFilesystem is set by the adapter layer before Bootstrap.
+// It provides the R2-backed filesystem for the WASM runtime.
+var NewWasmFilesystem func() (*filesystem.System, error)
+
+// NewWasmBackupsFilesystem is set by the adapter layer before Bootstrap.
+var NewWasmBackupsFilesystem func() (*filesystem.System, error)
+
+func (app *BaseApp) NewFilesystem() (*filesystem.System, error) {
+	if NewWasmFilesystem == nil {
+		return nil, fmt.Errorf("NewWasmFilesystem: not configured (call adapter.SetFilesystemDrivers before Bootstrap)")
+	}
+	return NewWasmFilesystem()
+}
+
+func (app *BaseApp) NewBackupsFilesystem() (*filesystem.System, error) {
+	if NewWasmBackupsFilesystem == nil {
+		return nil, fmt.Errorf("NewWasmBackupsFilesystem: not configured (call adapter.SetFilesystemDrivers before Bootstrap)")
+	}
+	return NewWasmBackupsFilesystem()
+}
