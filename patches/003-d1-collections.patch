new file mode 100644
index 0000000..2675835
--- /dev/null
+++ b/core/collection_d1.go
@@ -0,0 +1,130 @@
+package core
+
+import (
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+
+	"github.com/pocketbase/pocketbase/tools/security"
+)
+
+func checkD1ViewDependencies(app App, collection *Collection) error {
+	if !D1BatchMode {
+		return nil
+	}
+	views, err := app.FindAllCollections(CollectionTypeView)
+	if err != nil {
+		return err
+	}
+	for _, view := range views {
+		if view.Id == collection.Id {
+			continue
+		}
+		parsed := new(identifiersParser)
+		if err := parsed.parse(view.ViewQuery); err != nil {
+			return err
+		}
+		for _, table := range parsed.tables {
+			if strings.EqualFold(table.original, collection.Name) {
+				return fmt.Errorf("[%s] failed to delete due to existing view dependency (%s)", collection.Name, view.Name)
+			}
+		}
+	}
+	return nil
+}
+
+// D1 introspection must run before a queued schema write. SQLite introspection
+// stays on its active transaction so uncommitted schema changes remain visible.
+func d1ReadApp(app App) App {
+	if D1BatchMode {
+		for app.TxInfo() != nil && app.TxInfo().parent != nil {
+			app = app.TxInfo().parent
+		}
+	}
+	return app
+}
+
+// Schema introspection cannot acquire a second write transaction while a D1
+// import holds the nonconcurrent connection. Native SQLite keeps its transaction.
+func runViewRead(app App, fn func(App) error) error {
+	if D1BatchMode {
+		return fn(d1ReadApp(app))
+	}
+	return app.RunInTransaction(fn)
+}
+
+func d1QueryTableInfo(app App, query string) (info []*TableInfoRow, err error) {
+	app = d1ReadApp(app)
+	query, err = normalizeViewSelectQuery(query)
+	if err != nil {
+		return nil, err
+	}
+
+	query, err = d1ViewQuery(app, query)
+	if err != nil {
+		return nil, err
+	}
+
+	// D1 HTTP requests have no session-scoped TEMP tables. Use a unique view,
+	// inspect it on the independent connection, then remove it on every path.
+	name := "_temp_" + security.PseudorandomString(12)
+	db := app.ConcurrentDB()
+	if _, err = db.NewQuery("CREATE VIEW {{" + name + "}} AS SELECT * FROM (" + query + ")").Execute(); err != nil {
+		return nil, err
+	}
+	defer func() {
+		_, cleanupErr := db.NewQuery("DROP VIEW IF EXISTS {{" + name + "}}").Execute()
+		err = errors.Join(err, cleanupErr)
+	}()
+	return app.TableInfo(name)
+}
+
+func d1ViewQuery(app App, query string) (string, error) {
+	var err error
+
+	// During import, CTEs describe the proposed schema, including views that
+	// depend on other views whose CREATE statements have not committed yet.
+	if imported, ok := app.Store().Get("pocketflareImportCollections").(map[string]*Collection); ok {
+		quote := func(s string) string { return `"` + strings.ReplaceAll(s, `"`, `""`) + `"` }
+		definitions := make([]string, 0, len(imported))
+		for _, collection := range imported {
+			selectQuery := collection.ViewQuery
+			if collection.IsView() {
+				selectQuery, err = normalizeViewSelectQuery(selectQuery)
+				if err != nil {
+					return "", err
+				}
+			} else {
+				columns := make([]string, 0, len(collection.Fields))
+				original, _ := app.FindCachedCollectionByNameOrId(collection.Id)
+				for _, field := range collection.Fields {
+					columnType := strings.Fields(field.ColumnType(app))
+					if len(columnType) == 0 {
+						continue
+					}
+					value := "CAST(NULL AS " + columnType[0] + ")"
+					if original != nil && !original.IsView() {
+						if oldField := original.Fields.GetById(field.GetId()); oldField != nil {
+							value = quote(oldField.GetName())
+						}
+					}
+					columns = append(columns, value+" AS "+quote(field.GetName()))
+				}
+				selectQuery = "SELECT " + strings.Join(columns, ",")
+				if original != nil && !original.IsView() {
+					selectQuery += " FROM main." + quote(original.Name)
+				} else {
+					selectQuery += " WHERE 0"
+				}
+			}
+			definitions = append(definitions, quote(collection.Name)+" AS ("+selectQuery+")")
+		}
+		sort.Strings(definitions)
+		if len(definitions) > 0 {
+			query = "WITH " + strings.Join(definitions, ",") + " SELECT * FROM (" + query + ")"
+		}
+	}
+
+	return query, nil
+}
