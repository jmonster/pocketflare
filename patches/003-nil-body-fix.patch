From 093284e54515d3f7cc26ee7e4db30fef58bb4dd6 Mon Sep 17 00:00:00 2001
From: Johnny D <goforjohnny@icloud.com>
Date: Sat, 30 May 2026 02:51:57 -0400
Subject: [PATCH 4/5] fix: guard against nil ReadCloser in RereadableReadCloser

Cloudflare Workers fetch handler can pass nil for GET request bodies.
The syumai/workers bridge returns nil from ToBody() for null ReadableStream,
which causes a nil pointer dereference when Close() is called.
---
 tools/router/rereadable_read_closer.go | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/tools/router/rereadable_read_closer.go b/tools/router/rereadable_read_closer.go
index 25ce758..f798078 100644
--- a/tools/router/rereadable_read_closer.go
+++ b/tools/router/rereadable_read_closer.go
@@ -69,8 +69,10 @@ func (r *RereadableReadCloser) Reread() {
 	}

 	// eagerly close the old reader to prevent accumulating too much memory or temp files
-	if err := r.ReadCloser.Close(); err != nil {
-		r.closeErrors = append(r.closeErrors, err)
+	if r.ReadCloser != nil {
+		if err := r.ReadCloser.Close(); err != nil {
+			r.closeErrors = append(r.closeErrors, err)
+		}
 	}

 	r.ReadCloser = r.copy
@@ -88,8 +90,10 @@ func (r *RereadableReadCloser) Close() error {
 		}
 	}

-	if err := r.ReadCloser.Close(); err != nil {
-		r.closeErrors = append(r.closeErrors, err)
+	if r.ReadCloser != nil {
+		if err := r.ReadCloser.Close(); err != nil {
+			r.closeErrors = append(r.closeErrors, err)
+		}
 	}

 	return errors.Join(r.closeErrors...)
--
