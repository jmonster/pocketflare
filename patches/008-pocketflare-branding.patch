+const POCKETBASE_DEFAULT_ACCENT_COLOR = "#1055c9";
+const POCKETFLARE_DEFAULT_ACCENT_COLOR = "#404041";
+
+function normalizePocketflareAccentColor(color) {
+    return (color || "").toLowerCase() === POCKETBASE_DEFAULT_ACCENT_COLOR
+        ? POCKETFLARE_DEFAULT_ACCENT_COLOR
+        : color;
+}
+
+function normalizePocketflareSettings(settings = {}) {
+    if (settings.meta?.accentColor) {
+        settings.meta = {
+            ...settings.meta,
+            accentColor: normalizePocketflareAccentColor(settings.meta.accentColor),
+        };
+    }
+
+    return settings;
+}
 
