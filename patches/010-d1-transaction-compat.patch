+// checkViewDependencies returns an error if any view collection's query
+// references the named collection. This uses a simple substring scan of
+// ViewQuery and may produce false positives for names that appear in
+// literals, comments, or substrings. It runs outside any write transaction
+// so D1 batch mode doesn't hit query-after-write during collection delete.
+func checkViewDependencies(app App, collection *Collection) error {
+	views, err := app.FindAllCollections(CollectionTypeView)
+	if err != nil {
+		return err
+	}
+	for _, v := range views {
+		if v.Id == collection.Id {
+			continue
+		}
+		if strings.Contains(v.ViewQuery, collection.Name) {
+			return fmt.Errorf("[%s] failed to delete due to existing view dependency (%s)", collection.Name, v.Name)
+		}
+	}
+	return nil
+}
