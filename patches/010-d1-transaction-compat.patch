+
+// splitSQLStatements splits a SQL string on ";" delimiters,
+// skipping empty segments and trimming whitespace.
+func splitSQLStatements(query string) []string {
+	parts := strings.Split(query, ";")
+	out := make([]string, 0, len(parts))
+	for _, p := range parts {
+		p = strings.TrimSpace(p)
+		if p != "" {
+			out = append(out, p)
+		}
+	}
+	return out
+}
