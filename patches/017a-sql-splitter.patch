+// splitSQLStatements splits a SQL string on ";" delimiters using a
+// rune-based state machine that respects string literals, blob literals,
+// and comments so that semicolons inside those constructs are not treated
+// as statement boundaries.
 func splitSQLStatements(query string) []string {
-	parts := strings.Split(query, ";")
-	out := make([]string, 0, len(parts))
-	for _, p := range parts {
-		p = strings.TrimSpace(p)
-		if p != "" {
-			out = append(out, p)
+	var out []string
+	runes := []rune(query)
+	var buf strings.Builder
+	n := len(runes)
+
+	const (
+		sNormal = iota
+		sSingleQuote
+		sDoubleQuote
+		sBlob
+		sLineComment
+		sBlockComment
+	)
+
+	st := sNormal
+
+	for i := 0; i < n; i++ {
+		ch := runes[i]
+
+		switch st {
+		case sNormal:
+			switch {
+			case ch == '\'':
+				st = sSingleQuote
+				buf.WriteRune(ch)
+			case ch == '"':
+				st = sDoubleQuote
+				buf.WriteRune(ch)
+			case (ch == 'X' || ch == 'x') && i+1 < n && runes[i+1] == '\'':
+				buf.WriteRune(ch)
+				buf.WriteRune(runes[i+1])
+				i++
+				st = sBlob
+			case ch == '-' && i+1 < n && runes[i+1] == '-':
+				buf.WriteString("--")
+				i++
+				st = sLineComment
+			case ch == '/' && i+1 < n && runes[i+1] == '*':
+				buf.WriteString("/*")
+				i++
+				st = sBlockComment
+			case ch == ';':
+				s := strings.TrimSpace(buf.String())
+				if s != "" {
+					out = append(out, s)
+				}
+				buf.Reset()
+			default:
+				buf.WriteRune(ch)
+			}
+
+		case sSingleQuote:
+			buf.WriteRune(ch)
+			if ch == '\'' {
+				if i+1 < n && runes[i+1] == '\'' {
+					i++
+					buf.WriteRune(runes[i])
+				} else {
+					st = sNormal
+				}
+			}
+
+		case sDoubleQuote:
+			buf.WriteRune(ch)
+			if ch == '"' {
+				if i+1 < n && runes[i+1] == '"' {
+					i++
+					buf.WriteRune(runes[i])
+				} else {
+					st = sNormal
+				}
+			}
+
+		case sBlob:
+			buf.WriteRune(ch)
+			if ch == '\'' {
+				if i+1 < n && runes[i+1] == '\'' {
+					i++
+					buf.WriteRune(runes[i])
+				} else {
+					st = sNormal
+				}
+			}
+
+		case sLineComment:
+			buf.WriteRune(ch)
+			if ch == '\n' {
+				st = sNormal
+			}
+
+		case sBlockComment:
+			buf.WriteRune(ch)
+			if ch == '*' && i+1 < n && runes[i+1] == '/' {
+				i++
+				buf.WriteRune('/')
+				st = sNormal
+			}
 		}
 	}
+
+	// Last statement
+	if s := strings.TrimSpace(buf.String()); s != "" {
+		out = append(out, s)
+	}
+
 	return out
 }
