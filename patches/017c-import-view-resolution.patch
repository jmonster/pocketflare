diff --git a/core/collection_query.go b/core/collection_query.go
index e84564a..521e931 100644
--- a/core/collection_query.go
+++ b/core/collection_query.go
@@ -60,17 +60,35 @@ func (app *BaseApp) ReloadCachedCollections() error {
 
 // FindCollectionByNameOrId finds a single collection by its name (case insensitive) or id.
 func (app *BaseApp) FindCollectionByNameOrId(nameOrId string) (*Collection, error) {
+	// During an import the merged collection map is stored so that lookups
+	// resolve from the in-memory map instead of querying the database
+	// (which may not reflect in-progress changes on D1).
+	if m, ok := app.Store().GetOk("pocketflareImportCollections"); ok {
+		if imported, ok := m.(map[string]*Collection); ok {
+			// check by id first
+			if c, exists := imported[nameOrId]; exists {
+				return c, nil
+			}
+			// check by name (case insensitive)
+			for _, c := range imported {
+				if strings.EqualFold(c.Name, nameOrId) {
+					return c, nil
+				}
+			}
+		}
+	}
+
 	m := &Collection{}
 
 	err := app.CollectionQuery().
 		AndWhere(dbx.NewExp("[[id]]={:id} OR LOWER([[name]])={:name}", dbx.Params{
 			"id":   nameOrId,
 			"name": strings.ToLower(nameOrId),
 		})).
 		Limit(1).
 		One(m)
 	if err != nil {
 		return nil, err
 	}
 
 	return m, nil
 }
