@@ -884,12 +884,19 @@ func onCollectionSaveExecute(e *CollectionEvent) error {
 	var viewFields FieldsList
 	var normalizedViewQuery string
 	if e.Collection.IsView() {
+		// Use the parent app if we are inside a transaction to avoid
+		// creating temp views within a D1 batch where reads after
+		// writes are not allowed.
+		viewApp := e.App
+		if info := e.App.TxInfo(); info != nil && info.parent != nil {
+			viewApp = info.parent
+		}
 		var err error
-		viewFields, err = e.App.CreateViewFields(e.Collection.ViewQuery)
+		viewFields, err = viewApp.CreateViewFields(e.Collection.ViewQuery)
 		if err != nil {
 			return err
 		}
-		normalizedViewQuery, err = normalizeViewQueryId(e.App, e.Collection.ViewQuery)
+		normalizedViewQuery, err = normalizeViewQueryId(viewApp, e.Collection.ViewQuery)
 		if err != nil {
 			return fmt.Errorf("failed to normalize view query id: %w", err)
 		}
